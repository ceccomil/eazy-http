<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Description>EazyHttp contracts and abstractions</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>EazyHttp.Abstractions</AssemblyName>
    <PackageId>EazyHttp.Abstractions</PackageId>
    <PackageTags>eazy;http;client;rest;get;post;send;put;multipart;form</PackageTags>
    <IsPackable>True</IsPackable>
    <RootNamespace>EazyHttp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="[8.0.6,11.0.0)" />
  </ItemGroup>

</Project>
