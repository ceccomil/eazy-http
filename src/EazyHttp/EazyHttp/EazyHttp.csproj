<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Friendly and helpful library to handle HTTP requests</Description>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>EazyHttp</AssemblyName>
    <PackageId>EazyHttp</PackageId>
    <PackageTags>eazy;http;client;rest;get;post;send;put;multipart;form</PackageTags>
    <IsPackable>True</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="[8.0.1,11.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="[8.0.22,11.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EazyHttp.Abstractions\EazyHttp.Abstractions.csproj" />
    <ProjectReference Include="..\EazyHttp.Generator\EazyHttp.Generator.csproj" />
  </ItemGroup>
  
</Project>
